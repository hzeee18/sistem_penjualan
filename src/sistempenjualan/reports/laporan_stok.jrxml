<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_stok" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="20" uuid="3c221134-0030-4740-95ac-4f8d99030449">
	<parameter name="NAMA_PT" class="java.lang.String"/><parameter name="DICETAK_OLEH" class="java.lang.String"/><parameter name="TEMPAT" class="java.lang.String"/><parameter name="MENGETAHUI" class="java.lang.String"/><parameter name="BATAS_PERINGATAN" class="java.lang.Integer"/><parameter name="BATAS_KRITIS" class="java.lang.Integer"/>
	<queryString language="SQL"><![CDATA[SELECT kode AS kode, nama AS nama_barang, IF(kategori='BAHAN_BAKU','Bahan Baku','Produk Jadi') AS kategori, satuan AS satuan,
 TRIM(TRAILING '.' FROM TRIM(TRAILING '0' FROM CAST(layak AS CHAR))) AS layak, TRIM(TRAILING '.' FROM TRIM(TRAILING '0' FROM CAST(kedaluwarsa AS CHAR))) AS kedaluwarsa, TRIM(TRAILING '.' FROM TRIM(TRAILING '0' FROM CAST(stok_minimum AS CHAR))) AS minimum,
 IFNULL(DATE_FORMAT(terdekat, '%d-%m-%Y'), '-') AS terdekat,
 CASE WHEN layak <= 0 THEN 'HABIS' WHEN layak <= stok_minimum THEN 'MENIPIS' ELSE 'AMAN' END AS status
FROM (SELECT b.kode, b.nama, b.kategori, b.satuan, b.stok_minimum,
 COALESCE(SUM(CASE WHEN bt.tgl_kedaluwarsa >= CURDATE() THEN bt.qty_sisa END),0) AS layak,
 COALESCE(SUM(CASE WHEN bt.tgl_kedaluwarsa < CURDATE() THEN bt.qty_sisa END),0) AS kedaluwarsa,
 MIN(CASE WHEN bt.qty_sisa > 0 AND bt.tgl_kedaluwarsa >= CURDATE() THEN bt.tgl_kedaluwarsa END) AS terdekat
 FROM m_barang b LEFT JOIN batch bt ON bt.barang_id = b.id GROUP BY b.id) s ORDER BY kategori, kode]]></queryString>
	<field name="kode" class="java.lang.String"/><field name="nama_barang" class="java.lang.String"/><field name="kategori" class="java.lang.String"/><field name="satuan" class="java.lang.String"/><field name="layak" class="java.lang.String"/><field name="kedaluwarsa" class="java.lang.String"/><field name="minimum" class="java.lang.String"/><field name="terdekat" class="java.lang.String"/><field name="status" class="java.lang.String"/>
	<title><band height="92" splitType="Stretch"><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="0" width="802" height="18" uuid="06f8d39d-994c-40a5-820b-b25f69986810" forecolor="#2E7D5B"/><box leftPadding="0" rightPadding="0"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="13" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{NAMA_PT}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="18" width="802" height="14" uuid="541fc2dc-3134-4db1-91b7-558d2d3edb28" forecolor="#6B7280"/><box leftPadding="0" rightPadding="0"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["Sistem Monitoring Persediaan dan Kedaluwarsa Barang"]]></textFieldExpression></textField><line><reportElement x="0" y="38" width="802" height="1" uuid="bb5d6a01-d7f7-4910-9826-899311de7d52" forecolor="#2E7D5B"/><graphicElement><pen lineWidth="1.5"/></graphicElement></line><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="46" width="802" height="22" uuid="ca3a9f08-60a5-4437-8f16-9b732be04b59"/><box leftPadding="0" rightPadding="0"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="14" isBold="true"/></textElement><textFieldExpression><![CDATA["LAPORAN STOK PERSEDIAAN"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="68" width="802" height="16" uuid="e7c1ffeb-01fa-4b0d-a1d8-7586449be8e3" forecolor="#4B5563"/><box leftPadding="0" rightPadding="0"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["Per tanggal " + new java.text.SimpleDateFormat("dd MMMM yyyy", new java.util.Locale("id","ID")).format(new java.util.Date())]]></textFieldExpression></textField></band></title>
