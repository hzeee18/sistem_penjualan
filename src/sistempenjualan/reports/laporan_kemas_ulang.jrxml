<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_kemas_ulang" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="20" uuid="7a67d4ba-5b26-4de9-a4ee-c01b8f15eb3a">
	<parameter name="NAMA_PT" class="java.lang.String"/><parameter name="DICETAK_OLEH" class="java.lang.String"/><parameter name="TEMPAT" class="java.lang.String"/><parameter name="MENGETAHUI" class="java.lang.String"/><parameter name="BATAS_PERINGATAN" class="java.lang.Integer"/><parameter name="BATAS_KRITIS" class="java.lang.Integer"/><parameter name="TGL_DARI" class="java.sql.Date"/><parameter name="TGL_SAMPAI" class="java.sql.Date"/><parameter name="PERIODE" class="java.lang.String"/>
	<queryString language="SQL"><![CDATA[SELECT k.no_dokumen AS no_dok, DATE_FORMAT(k.created_at, '%d-%m-%Y') AS tgl, p.nama AS produk, TRIM(TRAILING '.' FROM TRIM(TRAILING '0' FROM CAST(k.qty_hasil AS CHAR))) AS qty, p.satuan AS satuan,
 bt.no_batch AS batch_hasil, DATE_FORMAT(bt.tgl_kedaluwarsa, '%d-%m-%Y') AS tgl_exp,
 CAST((SELECT GROUP_CONCAT(CONCAT(b2.no_batch, ' (', TRIM(TRAILING '.' FROM TRIM(TRAILING '0' FROM CAST(d.qty_pakai AS CHAR))), ' ', bb.satuan, ')') SEPARATOR ', ')
   FROM kemas_ulang_detail d JOIN batch b2 ON b2.id = d.batch_id JOIN m_barang bb ON bb.id = b2.barang_id WHERE d.kemas_ulang_id = k.id) AS CHAR) AS bahan,
 u.nama_lengkap AS oleh
FROM kemas_ulang k JOIN m_barang p ON p.id = k.produk_id JOIN batch bt ON bt.id = k.batch_hasil_id JOIN m_user u ON u.id = k.created_by
WHERE DATE(k.created_at) BETWEEN $P{TGL_DARI} AND $P{TGL_SAMPAI}
ORDER BY k.created_at, k.id]]></queryString>
	<field name="no_dok" class="java.lang.String"/><field name="tgl" class="java.lang.String"/><field name="produk" class="java.lang.String"/><field name="qty" class="java.lang.String"/><field name="satuan" class="java.lang.String"/><field name="batch_hasil" class="java.lang.String"/><field name="tgl_exp" class="java.lang.String"/><field name="bahan" class="java.lang.String"/><field name="oleh" class="java.lang.String"/>
