	<summary><band height="120" splitType="Stretch"><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="16" width="300" height="14" uuid="03b370e1-5523-46a6-ae82-0f619043a2e6" forecolor="#6B7280"/><box leftPadding="0" rightPadding="0"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["Dicetak oleh: " + $P{DICETAK_OLEH}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="30" width="300" height="14" uuid="f7a34666-61fa-4e6a-b9e2-41c1af1e7e6a" forecolor="#6B7280"/><box leftPadding="0" rightPadding="0"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["Jumlah data: " + $V{REPORT_COUNT}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="582" y="16" width="220" height="14" uuid="b3b72ee7-e044-4da5-ac5e-1cef504167a6"/><box leftPadding="0" rightPadding="0"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$P{TEMPAT} + ", " + new java.text.SimpleDateFormat("dd MMMM yyyy", new java.util.Locale("id","ID")).format(new java.util.Date())]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="582" y="30" width="220" height="14" uuid="def8af3d-5a29-4113-be27-b9e64cce45a8"/><box leftPadding="0" rightPadding="0"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["Mengetahui,"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="582" y="44" width="220" height="14" uuid="5ad80feb-bddd-43d8-9ba7-b838c8089c57"/><box leftPadding="0" rightPad