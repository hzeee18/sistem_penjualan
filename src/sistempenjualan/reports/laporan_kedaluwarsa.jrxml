	<summary><band height="120" splitType="Stretch"><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="16" width="300" height="14" uuid="c8a448df-9fc2-4ee5-a853-e543c3ef6f6c" forecolor="#6B7280"/><box leftPadding="0" rightPadding="0"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["Dicetak oleh: " + $P{DICETAK_OLEH}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="30" width="300" height="14" uuid="867675cd-5415-4afc-a035-caf4bac16ca1" forecolor="#6B7280"/><box leftPadding="0" rightPadding="0"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["Jumlah data: " + $V{REPORT_COUNT}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="582" y="16" width="220" height="14" uuid="6d966188-b0a4-4dda-8101-0f42bc3ca4fd"/><box leftPadding="0" rightPadding="0"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA[$P{TEMPAT} + ", " + new java.text.SimpleDateFormat("dd MMMM yyyy", new java.util.Locale("id","ID")).format(new java.util.Date())]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="582" y="30" width="220" height="14" uuid="91ae30e4-48d6-4189-8708-f391553dd21d"/><box leftPadding="0" rightPadding="0"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["Mengetahui,"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="582" y="44" width="220" height="14" uuid="c2edd4f5-c78c-4930-8fe2-d819306a2f11"/><box leftPadding="0" rightPad