<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_kedaluwarsa" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="20" uuid="7a23c95c-8a24-4e36-894c-956dc9ad274e">
	<parameter name="NAMA_PT" class="java.lang.String"/><parameter name="DICETAK_OLEH" class="java.lang.String"/><parameter name="TEMPAT" class="java.lang.String"/><parameter name="MENGETAHUI" class="java.lang.String"/><parameter name="BATAS_PERINGATAN" class="java.lang.Integer"/><parameter name="BATAS_KRITIS" class="java.lang.Integer"/>
	<queryString language="SQL"><![CDATA[SELECT bt.no_batch AS no_batch, b.nama AS nama_barang, IF(b.kategori='BAHAN_BAKU','Bahan Baku','Produk Jadi') AS kategori,
 TRIM(TRAILING '.' FROM TRIM(TRAILING '0' FROM CAST(bt.qty_sisa AS CHAR))) AS sisa, b.satuan AS satuan, DATE_FORMAT(bt.tgl_masuk, '%d-%m-%Y') AS tgl_masuk, DATE_FORMAT(bt.tgl_kedaluwarsa, '%d-%m-%Y') AS tgl_exp,
 CAST(IF(DATEDIFF(bt.tgl_kedaluwarsa, CURDATE()) < 0, CONCAT('lewat ', -DATEDIFF(bt.tgl_kedaluwarsa, CURDATE()), ' hari'), CONCAT(DATEDIFF(bt.tgl_kedaluwarsa, CURDATE()), ' hari')) AS CHAR) AS sisa_hari,
 CASE WHEN bt.tgl_kedaluwarsa < CURDATE() THEN 'KEDALUWARSA' WHEN DATEDIFF(bt.tgl_kedaluwarsa, CURDATE()) <= $P{BATAS_KRITIS} THEN 'KRITIS' WHEN DATEDIFF(bt.tgl_kedaluwarsa, CURDATE()) <= $P{BATAS_PERINGATAN} THEN 'PERINGATAN' ELSE 'AMAN' END AS status
FROM batch bt JOIN m_barang b ON b.id = bt.barang_id
WHERE bt.qty_sisa > 0 AND bt.tgl_kedaluwarsa <= CURDATE() + INTERVAL $P{BATAS_PERINGATAN} DAY
ORDER BY bt.tgl_kedaluwarsa]]></queryString>
	<field name="no_batch" class="java.lang.String"/><field name="nama_barang" class="java.lang.String"/><field name="kategori" class="java.lang.String"/><field name="sisa" class="java.lang.String"/><field name="satuan" class="java.lang.String"/><field name="tgl_masuk" class="java.lang.String"/><field name="tgl_exp" class="java.lang.String"/><field name="sisa_hari" class="java.lang.String"/><field name="status" class="java.lang.String"/>
	<title><band height="92" splitType="Stretch"><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="0" width="802" height="18" uuid="afc86261-eb05-41f4-9e39-0a73b990dea8" forecolor="#2E7D5B"/><box leftPadding="0" rightPadding="0"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="13" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{NAMA_PT}]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="18" width="802" height="14" uuid="e548a1d6-4cd5-469f-8926-f0e2640ba9c5" forecolor="#6B7280"/><box leftPadding="0" rightPadding="0"/><textElement textAlignment="Left" verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement><textFieldExpression><![CDATA["Sistem Monitoring Persediaan dan Kedaluwarsa Barang"]]></textFieldExpression></textField><line><reportElement x="0" y="38" width="802" height="1" uuid="fb75ab2b-f844-457e-bbb0-2925134a8e9c" forecolor="#2E7D5B"/><graphicElement><pen lineWidth="1.5"/></graphicElement></line><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="46" width="802" height="22" uuid="39d1cfbb-19fe-4577-83ce-7de115f93746"/><box leftPadding="0" rightPadding="0"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="14" isBold="true"/></textElement><textFieldExpression><![CDATA["LAPORAN BARANG KEDALUWARSA & HAMPIR KEDALUWARSA"]]></textFieldExpression></textField><textField textAdjust="StretchHeight" isBlankWhenNull="true"><reportElement x="0" y="68" width="802" height="16" uuid="5b088401-e56b-4fa0-a5fb-539c7b2191a2" forecolor="#4B5563"/><box leftPadding="0" rightPadding="0"/><textElement textAlignment="Center" verticalAlignment="Middle"><font fontName="SansSerif" size="9"/></textElement><textFieldExpression><![CDATA["Batch kedaluwarsa dan yang akan kedaluwarsa dalam " + $P{BATAS_PERINGATAN} + " hari • per " + new java.text.SimpleDateFormat("dd MMMM yyyy", new java.util.Locale("id","ID")).format(new java.util.Date())]]></textFieldExpression></textField></band></title>
