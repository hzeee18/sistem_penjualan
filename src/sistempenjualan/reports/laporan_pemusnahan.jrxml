<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_pemusnahan" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="20" uuid="be2cd23a-f3e0-4640-b09f-7a420e10129e">
	<parameter name="NAMA_PT" class="java.lang.String"/><parameter name="DICETAK_OLEH" class="java.lang.String"/><parameter name="TEMPAT" class="java.lang.String"/><parameter name="MENGETAHUI" class="java.lang.String"/><parameter name="BATAS_PERINGATAN" class="java.lang.Integer"/><parameter name="BATAS_KRITIS" class="java.lang.Integer"/><parameter name="TGL_DARI" class="java.sql.Date"/><parameter name="TGL_SAMPAI" class="java.sql.Date"/><parameter name="PERIODE" class="java.lang.String"/>
	<queryString language="SQL"><![CDATA[SELECT DATE_FORMAT(m.created_at, '%d-%m-%Y') AS tgl, bt.no_batch AS no_batch, b.nama AS nama_barang, TRIM(TRAILING '.' FROM TRIM(TRAILING '0' FROM CAST(m.qty AS CHAR))) AS qty, b.satuan AS satuan,
 DATE_FORMAT(bt.tgl_kedaluwarsa, '%d-%m-%Y') AS tgl_exp, IFNULL(m.keterangan, '') AS ket, u.nama_lengkap AS oleh
FROM mutasi_stok m JOIN batch bt ON bt.id = m.batch_id JOIN m_barang b ON b.id = bt.barang_id JOIN m_user u ON u.id = m.created_by
WHERE m.jenis = 'PEMUSNAHAN' AND DATE(m.created_at) BETWEEN $P{TGL_DARI} AND $P{TGL_SAMPAI}
ORDER BY m.created_at]]></queryString>
	<field name="tgl" class="java.lang.String"/><field name="no_batch" class="java.lang.String"/><field name="nama_barang" class="java.lang.String"/><field name="qty" class="java.lang.String"/><field name="satuan" class="java.lang.String"/><field name="tgl_exp" class="java.lang.String"/><field name="ket" class="java.lang.String"/><field name="oleh" class="java.lang.String"/>
