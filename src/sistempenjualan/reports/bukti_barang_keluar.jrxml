<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="bukti_barang_keluar" language="java" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="24" bottomMargin="20" uuid="7ffb5cef-7746-49c3-bc67-34fe7a64b2c8">
	<parameter name="NAMA_PT" class="java.lang.String"/><parameter name="DICETAK_OLEH" class="java.lang.String"/><parameter name="TEMPAT" class="java.lang.String"/><parameter name="MENGETAHUI" class="java.lang.String"/><parameter name="BATAS_PERINGATAN" class="java.lang.Integer"/><parameter name="BATAS_KRITIS" class="java.lang.Integer"/><parameter name="ID" class="java.lang.Integer"/>
	<queryString language="SQL"><![CDATA[SELECT k.no_dokumen AS no_dok, DATE_FORMAT(k.tanggal, '%d-%m-%Y') AS tgl, IFNULL(k.catatan, '-') AS catatan, c.nama AS customer,
 IFNULL(c.no_hp, '-') AS hp, IFNULL(c.alamat, '-') AS alamat, b.kode AS kode, b.nama AS nama_barang, bt.no_batch AS no_batch,
 DATE_FORMAT(bt.tgl_kedaluwarsa, '%d-%m-%Y') AS tgl_exp, TRIM(TRAILING '.' FROM TRIM(TRAILING '0' FROM CAST(d.qty AS CHAR))) AS qty, b.satuan AS satuan
FROM barang_keluar k JOIN m_customer c ON c.id = k.customer_id JOIN barang_keluar_detail d ON d.barang_keluar_id = k.id
JOIN batch bt ON bt.id = d.batch_id JOIN m_barang b ON b.id = bt.barang_id
WHERE k.id = $P{ID} ORDER BY d.id]]></queryString>
	<field name="kode" class="java.lang.String"/><field name="nama_barang" class="java.lang.String"/><field name="no_batch" class="java.lang.String"/><field name="tgl_exp" class="java.lang.String"/><field name="qty" class="java.lang.String"/><field name="satuan" class="java.lang.String"/><field name="no_dok" class="java.lang.String"/><field name="tgl" class="java.lang.String"/><field name="catatan" class="java.lang.String"/><field name="customer" class="java.lang.String"/><field name="hp" class="java.lang.String"/><field name="alamat" class="java.lang.String"/>
